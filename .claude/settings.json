{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan *)",
      "Bash(composer *)",
      "Bash(npm *)",
      "Bash(./vendor/bin/pest*)",
      "Bash(./vendor/bin/phpunit*)",
      "Bash(./vendor/bin/pint*)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git config *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)"
    ],
    "ask": [
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan db:wipe *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/vendor/**)",
      "Read(**/node_modules/**)",
      "Read(**/storage/framework/**)",
      "Read(**/public/build/**)"
    ]
  },
  "env": {
    "APP_ENV": "local"
  }
}
